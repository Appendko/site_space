for t=0,3,1 do
	local src = t * 0x100
	for i=1,0xD,1 do
		local dest = t * 0x100 + i
		itemNameforLog[ dest + 0x00 ] = itemNameforLog[ src + 0x00 ]
		itemNameforLog[ dest + 0x10 ] = itemNameforLog[ src + 0x10 ]
	end
	for i=1,0xC,1 do
		local dest = t * 0x100 + i
		itemNameforLog[ dest + 0x40 ] = itemNameforLog[ src + 0x40 ]
	end
	for i=1,0x3,1 do
		local dest = t * 0x100 + i
		itemNameforLog[ dest + 0x24 ] = itemNameforLog[ src + 0x24 ]
	end
	itemNameforLog[ src + 0x59 ] = itemNameforLog[ src + 0x58 ]
	itemNameforLog[ src + 0x5B ] = itemNameforLog[ src + 0x5A ]
	itemNameforLog[ src + 0x5D ] = itemNameforLog[ src + 0x5C ]
	itemNameforLog[ src + 0x5F ] = itemNameforLog[ src + 0x5E ]
	for i=1,0x4,1 do
		local dest = t * 0x100 + i
		itemNameforLog[ dest + 0x60 ] = itemNameforLog[ src + 0x60 ]
	end
	itemNameforLog[ src + 0x66 ] = itemNameforLog[ src + 0x65 ]
	for i=1,0x5,1 do
		local dest = t * 0x100 + i
		itemNameforLog[ dest + 0x68 ] = itemNameforLog[ src + 0x68 ]
	end
	itemNameforLog[ src + 0x6F ] = itemNameforLog[ src + 0x6E ]
	for i=1,0x3,1 do
		local dest = t * 0x100 + i
		itemNameforLog[ dest + 0x70 ] = itemNameforLog[ src + 0x70 ]
	end
end

local item_log_file = "item_log.txt"

function item_log.initialize_textlog()
  console.clear()
  local file = io.open(item_log_file,"w")
  file:close()
end

function item_log.get_item_textlog(item_num)
  local str = itemNameforLog[item_num]
  console.log(str)
  local file = io.open(item_log_file,"a")
  file:write(string.format("%s\n",str))
  file:close()
end
